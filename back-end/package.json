{
  "name": "borali-backend",
  "version": "1.0.0",
  "description": "API for cultural event recommendation platform in Manaus.",
  "homepage": "https://github.com/Borali-Manaus/borali-backend#readme",
  "bugs": {
    "url": "https://github.com/Borali-Manaus/borali-backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Borali-Manaus/borali-backend.git"
  },
  "license": "ISC",
  "keywords": [],
  "author": "",
  "main": "index.js",
  "scripts": {
    "start:dev": "tsx watch src/server.ts",
    "start": "node build/server.js",
    "test:create-prisma-environment": "npm link ./prisma/vitest-environment-prisma",
    "test:install-prisma-environment": "npm link vitest-environment-prisma",
    "build": "npx tsup src --out-dir build",
    "test": "vitest run --dir src/use-cases",
    "test:watch": "vitest --dir src/use-cases",
    "pretest:e2e": "run-s test:create-prisma-environment test:install-prisma-environment",
    "test:e2e": "vitest run --dir src/http",
    "test:e2e:watch": "vitest --dir src/http",
    "test:coverage": "vitest run --coverage.enabled true --coverage.reporter=text --coverage.reporter=html",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@rocketseat/eslint-config": "2.2.2",
    "@types/bcryptjs": "3.0.0",
    "@types/busboy": "1.5.4",
    "@types/node": "24.9.2",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.0.4",
    "@vitest/ui": "4.0.4",
    "eslint": "9.38.0",
    "npm-run-all": "4.1.5",
    "prisma": "6.18.0",
    "supertest": "7.1.4",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.920.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/jwt": "10.0.0",
    "@fastify/multipart": "9.3.0",
    "@fastify/swagger": "9.5.2",
    "@fastify/swagger-ui": "5.2.3",
    "@prisma/client": "6.18.0",
    "@sendgrid/mail": "8.1.6",
    "bcryptjs": "3.0.2",
    "dayjs": "1.11.18",
    "dotenv": "17.2.3",
    "fastify": "5.6.1",
    "fastify-type-provider-zod": "6.1.0",
    "zod": "4.1.12"
  }
}
