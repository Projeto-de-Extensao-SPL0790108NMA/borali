generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PERSON
  COMPANY
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password_hash String
  avatar_url    String?
  role          Role
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  company   Company?
  tokens    PasswordResetToken[]
  favorites EventFavorite[]
  comments  EventComments[]

  @@map("users")
}

model Company {
  id          String    @id @default(uuid())
  phone       String
  address     String
  description String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  user    User   @relation(fields: [user_id], references: [id])
  user_id String @unique

  events Event[]

  @@map("companies")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  code_hash  String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  @@index([user_id, expires_at])
  @@map("password_reset_tokens")
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  address     String
  date        DateTime
  latitude    Float
  longitude   Float
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  company    Company @relation(fields: [company_id], references: [id])
  company_id String

  images    EventImage[]
  favorites EventFavorite[]
  comments  EventComments[]

  @@index([company_id, title, date])
  @@map("events")
}

model EventImage {
  id         String    @id @default(uuid())
  url        String
  is_cover   Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  event    Event  @relation(fields: [event_id], references: [id])
  event_id String

  @@index([event_id])
  @@map("event_images")
}

model EventFavorite {
  id         String    @id @default(uuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  event    Event  @relation(fields: [event_id], references: [id])
  event_id String

  @@index([event_id, user_id])
  @@index([event_id])
  @@index([user_id])
  @@map("event_favorites")
}

model EventComments {
  id          String    @id @default(uuid())
  description String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  event    Event  @relation(fields: [event_id], references: [id])
  event_id String

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  @@index([event_id, user_id])
  @@map("event_comments")
}
